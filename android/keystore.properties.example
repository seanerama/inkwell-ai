# Example only — DO NOT commit a real keystore or real credentials.
# At release time GitHub Actions decodes the base64 keystore from the
# ANDROID_KEYSTORE_BASE64 secret to a file and exports these as env vars
# (INKWELL_KEYSTORE_PATH / _PASSWORD / INKWELL_KEY_ALIAS / _PASSWORD),
# which app/build.gradle.kts reads. Locally you may instead copy this file to
# keystore.properties (gitignored) and fill in real values.
storeFile=/absolute/path/to/upload-keystore.jks
storePassword=changeit
keyAlias=upload
keyPassword=changeit
