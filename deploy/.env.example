# Inkwell AI environment file. Copy to `.env` in the environment directory on the host
# (/srv/inkwell/<env>/.env), mode 600, owned by the operator. Never commit a real .env.
# Secret NAMES + locations are tracked in .verity/deploy-access.md; values live in the
# operator's password manager.

# Image tag to run (matches a GHCR release, e.g. v0.0.1).
# Image reference pinned by deploy.sh (tag or, preferably, @sha256 digest from the Release).
IMAGE_REF=ghcr.io/seanerama/inkwell-ai-server:latest

# Which environment this stack is (staging|prod). Also picks the host API port:
#   staging -> API_PORT=8001 (tailscale serve --https=8444)
#   prod    -> API_PORT=8000 (tailscale serve --https=8443)
INKWELL_ENV=staging
API_PORT=8001

# Agent kill-switch (default OFF). When true, the agent runs AND every deploy runs one
# live canary agent job after the health check (deploy/remote-deploy.sh) — the deploy
# fails loudly if that job does not come back done with >=1 annotation and >=1 card.
AGENT_ENABLED=false

# Spaces edit kill-switch (default OFF). When false, POST/PATCH /spaces return 403
# `disabled`; GET /spaces is unaffected. Turn on to create/edit spaces from a device.
SPACES_EDITABLE=false

# Push kill-switch (default OFF, ADR-0012). When false, `inkwell push` exits 2 with
# "push disabled" and the blob routes (POST /blobs, GET /blobs/{key}) return 403
# `disabled`. Turn on to let a server-side script push documents/canvases to a space.
PUSH_ENABLED=false

# Brain kill-switch (default OFF, ADR-0013). When false, brain_writes are NOT persisted,
# the /brain/{space_slug} routes return 403 `disabled`, and the `save_to_brain` card
# action returns 422 `not_implemented`. Turn on to persist and browse the brain.
BRAIN_ENABLED=false

# --- Off-host backups (ADR-0011, optional but expected) ---
# Backups always run locally on the host (nightly timer + pre-deploy). To ALSO copy each
# set off-host, set BACKUP_REMOTE to an rclone remote path (configure the remote in the
# host's ~/.rclone.conf / rclone.conf first, mode 600 — see .verity/deploy-access.md).
# Each set is then encrypted with `age` to BACKUP_AGE_RECIPIENT (a PUBLIC key) before it
# leaves the host; the matching PRIVATE key never lives on the host. Empty = local only.
#   e.g. r2:inkwell-backups/staging  or  gdrive:inkwell/staging
BACKUP_REMOTE=
# age recipient PUBLIC key (age1...) that the off-host copy is encrypted to. Required
# only when BACKUP_REMOTE is set.
BACKUP_AGE_RECIPIENT=

# --- Secrets (fill in on the host; keep out of git) ---
POSTGRES_PASSWORD=change-me
INKWELL_TOKEN_PEPPER=change-me
# Token-pepper rotation grace window (Stage 18, ADR-0008). Leave EMPTY in steady state
# (single-pepper = today's behaviour). During a pepper rotation set this to the OLD
# pepper and INKWELL_TOKEN_PEPPER to the NEW one: the server verifies against both and
# transparently re-hashes each token on its next request. Once `inkwell token
# migrate-check` returns 0 (all live tokens migrated), clear this and `up -d`.
INKWELL_TOKEN_PEPPER_PREVIOUS=
INKWELL_BLOB_SIGNING_KEY=change-me
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME
